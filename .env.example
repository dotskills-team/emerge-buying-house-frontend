# Server-side only: where Next.js forwards /api/* (and where server components read public blog
# data). In production, set it to the backend's Vercel URL, e.g. https://your-backend.vercel.app
API_PROXY_TARGET=http://localhost:5000

# Optional. Leave unset in production so the browser uses the same-origin /api proxy (required for
# the SameSite=Strict refresh cookie when frontend and backend are on different domains).
# NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Optional public contact address shown in the site footer. Not shown when unset.
# NEXT_PUBLIC_CONTACT_EMAIL=hello@yourdomain.com
